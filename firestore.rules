rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      // 페어링 확정/해제 시 상대 문서의 pairIds만 예외적으로 쓸 수 있음.
      allow update: if isSignedIn() && (
        request.auth.uid == uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pairIds'])
      );
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /pairs/{pairId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      // pending -> active 전환은 호스트 본인이 아닌 초대받은 쪽만.
      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && request.auth.uid != resource.data.hostUid;
      allow delete: if false;
    }
  }
}
